{
  "manifest_version": 2,
  "name": "AI Web for Zotero",
  "version": "1.1.0",
  "description": "AI websites beside Zotero, with PDF uploads, conversation bookmarks and note exports.",
  "author": "Li Yang",
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "64": "icons/logo-64.png",
    "96": "icons/logo-96.png",
    "128": "icons/logo-128.png",
    "256": "icons/logo-256.png"
  },
  "applications": {
    "zotero": {
      "id": "chatgpt-web-sidebar-demo@local",
      "update_url": "https://raw.githubusercontent.com/liyang-tju/AI-Web-for-Zotero/main/updates.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  }
}
