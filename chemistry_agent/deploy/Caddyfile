{$SITE_HOST} {
    encode zstd gzip
    request_body {
        max_size 1MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    reverse_proxy app:8765 {
        transport http {
            response_header_timeout 240s
        }
    }
}
