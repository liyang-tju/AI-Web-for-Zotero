# Copy to .env.server ON THE SERVER, then edit it there. Do not commit or share the real file.
SITE_HOST=chemistry.example.com
# Optional: use the official Docker images distributed through Amazon ECR Public.
# PYTHON_BASE_IMAGE=public.ecr.aws/docker/library/python:3.11-slim-bookworm
# CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=false
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TIMEOUT_SECONDS=60
CHEMISTRY_RUN_TIMEOUT_SECONDS=180
CHEMISTRY_SESSION_TTL_SECONDS=43200
CHEMISTRY_CONTEXT_WINDOW_TOKENS=32768
CHEMISTRY_CONTEXT_TRIGGER_RATIO=0.8
CHEMISTRY_CONTEXT_RECENT_TURNS=4
CHEMISTRY_CONTEXT_SUMMARY_TOKENS=1024
CHEMISTRY_CONTEXT_TOOL_RESULT_TOKENS=512
